{
  "$description": "IKIGAI ATLAS spacing, shape and sizing tokens (design-instructions §4.2, §4.3, §5.1, §6.4). 4px base unit.",
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "8px", "$description": "Small controls" },
    "md": { "$type": "dimension", "$value": "12px", "$description": "Standard card" },
    "lg": { "$type": "dimension", "$value": "16px", "$description": "Feature card / modal" },
    "xl": { "$type": "dimension", "$value": "20px", "$description": "Hero panel" },
    "pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Tags, filters and compact badges only"
    }
  },
  "size": {
    "touch-target": {
      "min": {
        "$type": "dimension",
        "$value": "44px",
        "$description": "Minimum touch target (WCAG 2.5.8 exceeded; iOS HIG)"
      },
      "preferred": {
        "$type": "dimension",
        "$value": "48px",
        "$description": "Preferred touch target"
      }
    },
    "icon": {
      "xs": { "$type": "dimension", "$value": "16px", "$description": "Inline metadata" },
      "sm": { "$type": "dimension", "$value": "18px" },
      "md": { "$type": "dimension", "$value": "20px", "$description": "Buttons, list rows" },
      "lg": { "$type": "dimension", "$value": "24px", "$description": "Primary navigation" }
    },
    "icon-stroke": {
      "$type": "number",
      "$value": 1.75,
      "$description": "Default outline icon stroke width (Tabler default is 2)"
    },
    "focus-ring": {
      "width": { "$type": "dimension", "$value": "2px" },
      "offset": { "$type": "dimension", "$value": "2px" }
    },
    "progress-track": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Slim progress indicator height"
    }
  }
}
