{
  "name": "atlas-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && npm run lint:components",
    "lint:components": "node scripts/check-component-files.mjs",
    "test:ci": "ng test --watch=false",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:performance": "ng build --configuration performance && playwright test -c playwright.performance.config.ts",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "e2e:visual:start": "node scripts/visual-server.mjs start",
    "e2e:visual:stop": "node scripts/visual-server.mjs stop",
    "bundle:check": "node scripts/check-bundle-no-mock.mjs",
    "tokens:build": "node scripts/design-tokens/build-tokens.mjs",
    "tokens:check": "node scripts/design-tokens/build-tokens.mjs --check",
    "contrast:check": "node scripts/design-tokens/check-contrast.mjs",
    "assets:export": "node scripts/assets/export-assets.mjs",
    "assets:validate": "node scripts/assets/validate-assets.mjs",
    "design:check": "npm run tokens:check && npm run contrast:check && npm run assets:validate",
    "verify": "npm run lockfile:check && npm run design:check && npm run lint && npm run lint:styles && npm run format:check && npm run test:ci && npm run build && npm run bundle:check",
    "lockfile:check": "node scripts/check-lockfile-registry.mjs",
    "start:ios": "CAP_SERVER_URL=http://localhost:4200 npx cap sync ios && npx cap open ios && ng serve --host 0.0.0.0",
    "start:ios:device": "CAP_SERVER_URL=http://$(ipconfig getifaddr en0):4200 npx cap sync ios && npx cap open ios && ng serve --host 0.0.0.0",
    "build:ios": "ng build --configuration development && npx cap sync ios && npx cap open ios",
    "build:android": "ng build --configuration development && npx cap sync android && npx cap open android"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tabler/icons-angular": "^3.51.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
